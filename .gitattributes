# The .cmd launchers must keep Windows (CRLF) line endings exactly as they
# are, including in the zip GitHub offers for download. Batch files with
# other line endings can misbehave.
*.cmd -text

*.ps1 text
*.json text
*.md text

# Images are binary.
*.png binary
*.jpg binary

# Shell and Python test scripts must keep Unix line endings.
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
